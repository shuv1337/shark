{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://shark.shuv.dev",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "dev.shuv.shark",
        "language": "en-US",
        "sku": "shark-ios"
      }
    }
  }
}
