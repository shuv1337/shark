#!/usr/bin/env bash
set -euo pipefail

deploy_root="${SHARK_DEPLOY_ROOT:-/home/exedev/shark}"
credential_root="${SHARK_CREDENTIAL_ROOT:-/etc/shark}"
destination="${1:-}"

if [[ "$#" -ne 1 || "$destination" != "$deploy_root/.env.new" ]]; then
  echo "Usage: shark-materialize-secrets $deploy_root/.env.new" >&2
  exit 64
fi

for command in bws jq install mktemp; do
  command -v "$command" >/dev/null || {
    echo "Required command is unavailable: $command" >&2
    exit 69
  }
done

token_file="$credential_root/bws-app-access-token"
project_file="$credential_root/bws-app-project-id"
if [[ ! -f "$token_file" || ! -f "$project_file" ]]; then
  echo "SHark application credential files are unavailable." >&2
  exit 78
fi

BWS_ACCESS_TOKEN="$(<"$token_file")"
project_id="$(<"$project_file")"
if [[ -z "$BWS_ACCESS_TOKEN" || ! "$project_id" =~ ^[0-9a-fA-F-]{36}$ ]]; then
  echo "SHark application credential files are invalid." >&2
  exit 78
fi
export BWS_ACCESS_TOKEN

install -d -m 700 "$deploy_root"
secrets_json="$(mktemp "$deploy_root/app-secrets.XXXXXXXX.json")"
environment_file="$(mktemp "$deploy_root/environment.XXXXXXXX")"
cleanup() {
  rm -f -- "$secrets_json" "$environment_file"
}
trap cleanup EXIT
chmod 600 "$secrets_json" "$environment_file"

if ! bws secret list "$project_id" --output json >"$secrets_json"; then
  echo "Unable to read the SHark application secret project." >&2
  exit 78
fi

if ! jq -e '
  type == "array"
  and all(.[]; (.key | type == "string") and (.value | type == "string"))
  and ([.[].key] | length == (unique | length))
' "$secrets_json" >/dev/null; then
  echo "The SHark application secret project is malformed or has duplicate keys." >&2
  exit 78
fi

secret_value() {
  local key="$1"
  local value
  if ! value="$(jq -er --arg key "$key" '
    [.[] | select(.key == $key)]
    | if length == 1 then .[0].value else error("missing") end
  ' "$secrets_json")"; then
    echo "Required SHark application secret is missing: $key" >&2
    exit 78
  fi
  printf '%s' "$value"
}

allowed_emails="$(secret_value ALLOWED_EMAILS)"
better_auth_secret="$(secret_value BETTER_AUTH_SECRET)"
apple_key_id="$(secret_value APPLE_SIGN_IN_KEY_ID)"
apple_team_id="$(secret_value APPLE_TEAM_ID)"
apple_private_key="$(secret_value APPLE_SIGN_IN_PRIVATE_KEY_BASE64)"
expo_access_token="$(secret_value EXPO_ACCESS_TOKEN)"
apns_key_id="$(secret_value APNS_KEY_ID)"
apns_private_key="$(secret_value APNS_PRIVATE_KEY_BASE64)"

if [[ ! "$allowed_emails" =~ ^[A-Za-z0-9.!%+_@,-]+$ ]] ||
  [[ ! "$better_auth_secret" =~ ^[A-Za-z0-9._~+/=-]{32,}$ ]] ||
  [[ ! "$apple_key_id" =~ ^[A-Za-z0-9]{10}$ ]] ||
  [[ ! "$apple_team_id" =~ ^[A-Za-z0-9]{10}$ ]] ||
  [[ ! "$apple_private_key" =~ ^[A-Za-z0-9+/=]+$ ]] ||
  [[ ! "$expo_access_token" =~ ^[A-Za-z0-9._~-]+$ ]] ||
  [[ ! "$apns_key_id" =~ ^[A-Za-z0-9]{10}$ ]] ||
  [[ ! "$apns_private_key" =~ ^[A-Za-z0-9+/=]+$ ]]; then
  echo "A SHark application secret has an unsafe or invalid format." >&2
  exit 78
fi

umask 077
{
  printf '%s\n' \
    "APP_URL=https://shark.shuv.dev" \
    "ALLOWED_EMAILS=$allowed_emails" \
    "BETTER_AUTH_SECRET=$better_auth_secret" \
    "APPLE_SIGN_IN_SERVICE_ID=dev.shuv.shark.web" \
    "APPLE_SIGN_IN_KEY_ID=$apple_key_id" \
    "APPLE_TEAM_ID=$apple_team_id" \
    "APPLE_SIGN_IN_PRIVATE_KEY=$apple_private_key" \
    "EXPO_ACCESS_TOKEN=$expo_access_token" \
    "APNS_KEY_ID=$apns_key_id" \
    "APNS_PRIVATE_KEY=$apns_private_key" \
    "SERVICE_RATE_LIMIT_PER_MINUTE=300" \
    "ACCOUNT_RATE_LIMIT_PER_MINUTE=1500"
} >"$environment_file"

chmod 600 "$environment_file"
mv -f -- "$environment_file" "$destination"
trap - EXIT
rm -f -- "$secrets_json"
