#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
test_root="$(mktemp -d)"
cleanup() {
  rm -rf -- "$test_root"
}
trap cleanup EXIT

deploy_root="$test_root/shark"
credential_root="$test_root/credentials"
fake_bin="$test_root/bin"
install -d -m 700 "$deploy_root" "$credential_root" "$fake_bin"
printf '%s\n' "app-test-token" >"$credential_root/op-app-service-account-token"
printf '%s\n' "backup-test-token" >"$credential_root/op-backup-service-account-token"

cat >"$fake_bin/op" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if { true >&9; } 2>/dev/null; then
  echo "1Password inherited the deployment lock descriptor." >&2
  exit 1
fi
if [[ "${OP_CACHE:-}" != "false" ]]; then
  echo "1Password would leave a background cache daemon running." >&2
  exit 1
fi
if [[ "${OP_FAIL:-0}" == "1" ]]; then
  exit 1
fi
token="${OP_SERVICE_ACCOUNT_TOKEN:-}"
case "$1 $2" in
  "item list")
    if [[ "$token" == "app-test-token" ]]; then
      jq -n --arg extra "${OP_EXTRA:-}" '
        [{id:"app-item-id",title:"SHark Production App",category:"SECURE_NOTE"}]
        + if $extra == "1"
          then [{id:"unexpected-item",title:"Unexpected",category:"SECURE_NOTE"}]
          else []
          end'
    else
      jq -n '[{id:"backup-item-id",title:"SHark Production Backup",category:"SECURE_NOTE"}]'
    fi
    ;;
  "item get")
    if [[ "$token" == "app-test-token" && "$3" == "app-item-id" ]]; then
      jq -n '{
        id:"app-item-id",
        title:"SHark Production App",
        category:"SECURE_NOTE",
        vault:{id:"app-vault-id"},
        fields:[
          {id:"notesPlain",label:"notesPlain",type:"STRING",value:""},
          {id:"allowed",label:"ALLOWED_EMAILS",type:"CONCEALED",value:"operator@example.com"},
          {id:"auth",label:"BETTER_AUTH_SECRET",type:"CONCEALED",value:"0123456789abcdefghijklmnopqrstuvwxyz"},
          {id:"apple-key",label:"APPLE_SIGN_IN_KEY_ID",type:"CONCEALED",value:"APPLEKEY01"},
          {id:"apple-team",label:"APPLE_TEAM_ID",type:"CONCEALED",value:"7H54B326YZ"},
          {id:"apple-private",label:"APPLE_SIGN_IN_PRIVATE_KEY_BASE64",type:"CONCEALED",value:"QUJDRA=="},
          {id:"expo",label:"EXPO_ACCESS_TOKEN",type:"CONCEALED",value:"expo-token_123"},
          {id:"vapid-public",label:"VAPID_PUBLIC_KEY",type:"CONCEALED",value:("B" + ("a" * 86))},
          {id:"vapid-private",label:"VAPID_PRIVATE_KEY",type:"CONCEALED",value:("b" * 43)},
          {id:"vapid-subject",label:"VAPID_SUBJECT",type:"CONCEALED",value:"mailto:operator@example.com"},
          {id:"apns-key",label:"APNS_KEY_ID",type:"CONCEALED",value:"APNSKEY001"},
          {id:"apns-private",label:"APNS_PRIVATE_KEY_BASE64",type:"CONCEALED",value:"RUZHSA=="},
          {id:"apns-dev-key",label:"APNS_SANDBOX_KEY_ID",type:"CONCEALED",value:"APNSDEV001"},
          {id:"apns-dev-private",label:"APNS_SANDBOX_PRIVATE_KEY_BASE64",type:"CONCEALED",value:"REVWR0g="}
        ]
      }'
    elif [[ "$token" == "backup-test-token" && "$3" == "backup-item-id" ]]; then
      jq -n '{
        id:"backup-item-id",
        title:"SHark Production Backup",
        category:"SECURE_NOTE",
        vault:{id:"backup-vault-id"},
        fields:[
          {id:"notesPlain",label:"notesPlain",type:"STRING",value:""},
          {id:"repo",label:"RESTIC_REPOSITORY",type:"CONCEALED",value:"sftp:user@example.com:repos/shark-prod"},
          {id:"password",label:"RESTIC_PASSWORD",type:"CONCEALED",value:"backup password"}
        ]
      }'
    else
      exit 1
    fi
    ;;
  *) exit 64 ;;
esac
EOF

cat >"$fake_bin/restic" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "$1" == "-o" ]]
[[ "$2" == "sftp.args=-F $SHARK_BACKUP_SSH_ROOT/config -o UserKnownHostsFile=$SHARK_BACKUP_SSH_ROOT/known_hosts" ]]
shift 2
snapshot="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
case "$1" in
  cat|forget) exit 0 ;;
  check)
    [[ "${RESTIC_FAIL_CHECK:-0}" != "1" ]]
    ;;
  backup)
    printf '%s\n' "$2" >"$SHARK_DEPLOY_ROOT/fake-source-path"
    printf '{"message_type":"summary","snapshot_id":"%s"}\n' "$snapshot"
    ;;
  dump)
    source_path="$(<"$SHARK_DEPLOY_ROOT/fake-source-path")"
    cat "$source_path"
    ;;
  snapshots)
    printf '[{"id":"%s","hostname":"shark-prod","tags":["shark-prod"]}]\n' "$snapshot"
    ;;
  *) exit 64 ;;
esac
EOF
chmod 700 "$fake_bin/op" "$fake_bin/restic"

export PATH="$fake_bin:$PATH"
export SHARK_DEPLOY_ROOT="$deploy_root"
export SHARK_CREDENTIAL_ROOT="$credential_root"
export SHARK_BACKUP_SSH_ROOT="$test_root/ssh"
mkdir -p "$SHARK_BACKUP_SSH_ROOT"
touch "$SHARK_BACKUP_SSH_ROOT/config" "$SHARK_BACKUP_SSH_ROOT/known_hosts"
exec 9>"$test_root/inherited-deploy.lock"

grep -Fqx 'current_new="$current_file.new"' "$repo_root/deploy/shark-deploy"
grep -Fqx 'cp "$provenance_file" "$current_new"' "$repo_root/deploy/shark-deploy"
grep -Fqx 'mv "$current_new" "$current_file"' "$repo_root/deploy/shark-deploy"
grep -Fqx '      APNS_SANDBOX_KEY_ID: ${APNS_SANDBOX_KEY_ID:?set APNS_SANDBOX_KEY_ID in .env}' "$repo_root/compose.yaml"
grep -Fqx '      APNS_SANDBOX_PRIVATE_KEY: ${APNS_SANDBOX_PRIVATE_KEY:?set APNS_SANDBOX_PRIVATE_KEY in .env}' "$repo_root/compose.yaml"

file_mode() {
  if stat -c '%a' "$1" >/dev/null 2>&1; then
    stat -c '%a' "$1"
  else
    stat -f '%Lp' "$1"
  fi
}

sha256_file() {
  if command -v sha256sum >/dev/null; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

"$repo_root/deploy/shark-materialize-secrets" "$deploy_root/.env.new"
[[ "$(file_mode "$deploy_root/.env.new")" == "600" ]]
grep -qx 'APP_URL=https://shark.shuv.dev' "$deploy_root/.env.new"
grep -qx 'APPLE_SIGN_IN_PRIVATE_KEY=QUJDRA==' "$deploy_root/.env.new"
grep -qx 'APNS_SANDBOX_KEY_ID=APNSDEV001' "$deploy_root/.env.new"
grep -qx 'APNS_SANDBOX_PRIVATE_KEY=REVWR0g=' "$deploy_root/.env.new"
grep -Eq '^VAPID_PUBLIC_KEY=B[a]{86}$' "$deploy_root/.env.new"
grep -Eq '^VAPID_PRIVATE_KEY=[b]{43}$' "$deploy_root/.env.new"
grep -qx 'VAPID_SUBJECT=mailto:operator@example.com' "$deploy_root/.env.new"
if grep -Eq 'app-test-token|backup-test-token' "$deploy_root/.env.new"; then
  echo "1Password service-account credential leaked into the runtime environment." >&2
  exit 1
fi
environment_before="$(sha256_file "$deploy_root/.env.new")"
if OP_FAIL=1 "$repo_root/deploy/shark-materialize-secrets" "$deploy_root/.env.new" \
  >/dev/null 2>&1; then
  echo "Secret materializer accepted a failed 1Password read." >&2
  exit 1
fi
environment_after="$(sha256_file "$deploy_root/.env.new")"
[[ "$environment_before" == "$environment_after" ]]
if OP_EXTRA=1 "$repo_root/deploy/shark-materialize-secrets" "$deploy_root/.env.new" \
  >/dev/null 2>&1; then
  echo "Secret materializer accepted an unexpected 1Password item." >&2
  exit 1
fi
[[ "$environment_before" == "$(sha256_file "$deploy_root/.env.new")" ]]

backup_dir="$deploy_root/backup.ABC123"
install -d -m 700 "$backup_dir"
backup_file="$backup_dir/hark.sqlite.pre-0123456789abcdef0123456789abcdef01234567"
printf 'sqlite fixture\n' >"$backup_file"
snapshot_id="$("$repo_root/deploy/shark-restic-backup" "$backup_file")"
[[ "$snapshot_id" == "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ]]
[[ ! -e "$backup_file" ]]

failed_backup_dir="$deploy_root/nightly-backup.FAIL01"
install -d -m 700 "$failed_backup_dir"
failed_backup_file="$failed_backup_dir/hark.sqlite.nightly-20260727T120000Z"
printf 'sqlite fixture retained on failure\n' >"$failed_backup_file"
if RESTIC_FAIL_CHECK=1 "$repo_root/deploy/shark-restic-backup" "$failed_backup_file" \
  >/dev/null 2>&1; then
  echo "Restic helper accepted a failed repository check." >&2
  exit 1
fi
[[ -f "$failed_backup_file" ]]

outside_file="$test_root/hark.sqlite.pre-0123456789abcdef0123456789abcdef01234567"
printf 'must remain\n' >"$outside_file"
if "$repo_root/deploy/shark-restic-backup" "$outside_file" >/dev/null 2>&1; then
  echo "Restic helper accepted a database outside the staging boundary." >&2
  exit 1
fi
[[ -f "$outside_file" ]]

# shark-deploy rollback: run the real script against fake docker, curl, gh, and flock, and
# deliver signals to its whole process group the way a dropped SSH session does.
deploy_fake_bin="$test_root/deploy-bin"
deploy_helpers="$test_root/deploy-helpers"
install -d -m 700 "$deploy_fake_bin" "$deploy_helpers"

cat >"$deploy_fake_bin/docker" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
hang() {
  if [[ "${FAKE_HANG_AT:-}" == "$1" ]]; then
    touch "$FAKE_STATE/reached"
    sleep 30
  fi
}
if [[ "$1" == "compose" ]]; then
  shift
  while [[ "$1" == --* ]]; do shift 2; done
  case "$1" in
    stop)
      echo "stop $SHARK_IMAGE" >>"$FAKE_STATE/log"
      hang stop
      ;;
    up)
      echo "up $SHARK_IMAGE" >>"$FAKE_STATE/log"
      printf '%s\n' "$SHARK_IMAGE" >"$FAKE_STATE/running"
      ;;
    ps) echo "fake-container" ;;
    *) exit 64 ;;
  esac
  exit 0
fi
case "$1" in
  pull) ;;
  image)
    if [[ "$4" == "{{.Id}}" ]]; then
      echo "id:$5"
    else
      echo "$5"
    fi
    ;;
  inspect)
    if [[ "${FAKE_WRONG_IMAGE:-0}" == "1" ]]; then
      echo "id:unexpected"
    else
      echo "id:$(<"$FAKE_STATE/running")"
    fi
    ;;
  run)
    [[ " $* " != *" test -f /data/hark.sqlite"* ]]
    ;;
  *) exit 64 ;;
esac
EOF

cat >"$deploy_fake_bin/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
url="${*: -1}"
case "$url" in
  http://127.0.0.1:8787/api/health)
    if [[ "${FAKE_HANG_AT:-}" == "health" ]]; then
      touch "$FAKE_STATE/reached"
      sleep 30
    fi
    ;;
  https://shark.shuv.dev/api/health) ;;
  https://shark.shuv.dev/robots.txt | https://shark.shuv.dev/sitemap.xml) printf '404' ;;
  https://shark.shuv.dev/*) printf '401' ;;
  *) exit 64 ;;
esac
EOF

cat >"$deploy_fake_bin/gh" <<'EOF'
#!/usr/bin/env bash
if [[ "${FAKE_HANG_AT:-}" == "attest" ]]; then
  touch "$FAKE_STATE/reached"
  sleep 30
fi
EOF

printf '#!/usr/bin/env bash\n' >"$deploy_fake_bin/flock"
printf '#!/usr/bin/env bash\nprintf "fake\\n" >"$1"\n' >"$deploy_helpers/shark-materialize-secrets"
printf '#!/usr/bin/env bash\nexit 1\n' >"$deploy_helpers/shark-restic-backup"
chmod 700 "$deploy_fake_bin"/* "$deploy_helpers"/*

previous_deploy_sha="1111111111111111111111111111111111111111"
previous_deploy_image="ghcr.io/shuv1337/shark@sha256:$(printf '1%.0s' {1..64})"
next_deploy_sha="2222222222222222222222222222222222222222"
next_deploy_digest="sha256:$(printf '2%.0s' {1..64})"
next_deploy_image="ghcr.io/shuv1337/shark@$next_deploy_digest"

# Usage: run_deploy <case> [signal] ; sets deploy_status and FAKE_STATE.
run_deploy() {
  local case_name="$1" signal="${2:-}"
  export FAKE_STATE="$test_root/deploy-$case_name"
  local root="$FAKE_STATE/root"
  install -d -m 700 "$root"
  : >"$FAKE_STATE/log"
  printf '%s\n' "$previous_deploy_image" >"$FAKE_STATE/running"
  printf '{"git_sha":"%s","image":"%s"}\n' "$previous_deploy_sha" "$previous_deploy_image" \
    >"$root/current"
  touch "$FAKE_STATE/compose.yaml"
  set -m
  PATH="$deploy_fake_bin:$PATH" \
    SHARK_DEPLOY_ROOT="$root" SHARK_COMPOSE_FILE="$FAKE_STATE/compose.yaml" \
    SHARK_HELPER_ROOT="$deploy_helpers" \
    "$repo_root/deploy/shark-deploy" "$next_deploy_sha" "$next_deploy_digest" \
    >"$FAKE_STATE/out" 2>&1 9>&- &
  local pid=$!
  set +m
  if [[ -n "$signal" ]]; then
    for _ in $(seq 1 100); do
      [[ -e "$FAKE_STATE/reached" ]] && break
      sleep 0.1
    done
    [[ -e "$FAKE_STATE/reached" ]] || {
      echo "shark-deploy $case_name never reached its hang point." >&2
      exit 1
    }
    kill "-$signal" -- "-$pid"
  fi
  deploy_status=0
  wait "$pid" || deploy_status=$?
}

assert_rolled_back() {
  [[ "$(tail -n 1 "$FAKE_STATE/log")" == "up $previous_deploy_image" ]] || {
    echo "shark-deploy did not restart the previous release ($1)." >&2
    cat "$FAKE_STATE/log" >&2
    exit 1
  }
  [[ "$(jq -r .git_sha "$FAKE_STATE/root/current")" == "$previous_deploy_sha" ]]
  if compgen -G "$FAKE_STATE/root/backup.*" >/dev/null; then
    echo "shark-deploy left its backup staging directory behind ($1)." >&2
    exit 1
  fi
}

FAKE_HANG_AT=stop run_deploy hup-during-stop HUP
[[ "$deploy_status" == "129" ]]
assert_rolled_back "SIGHUP while stopping the previous container"

FAKE_HANG_AT=health run_deploy hup-during-health HUP
[[ "$deploy_status" == "129" ]]
grep -qx "up $next_deploy_image" "$FAKE_STATE/log"
assert_rolled_back "SIGHUP while waiting for the new container"

FAKE_HANG_AT=health run_deploy term-during-health TERM
[[ "$deploy_status" == "143" ]]
assert_rolled_back "SIGTERM while waiting for the new container"

FAKE_WRONG_IMAGE=1 run_deploy wrong-image
[[ "$deploy_status" == "70" ]]
assert_rolled_back "running image mismatch"

FAKE_HANG_AT=attest run_deploy hup-before-stop HUP
[[ "$deploy_status" == "129" ]]
if [[ -s "$FAKE_STATE/log" ]]; then
  echo "shark-deploy touched the running container before it stopped it." >&2
  exit 1
fi

run_deploy success
[[ "$deploy_status" == "0" ]]
[[ "$(cat "$FAKE_STATE/log")" == "stop $previous_deploy_image"$'\n'"up $next_deploy_image" ]]
[[ "$(jq -r .git_sha "$FAKE_STATE/root/current")" == "$next_deploy_sha" ]]

echo "SHark deployment helper tests passed."
