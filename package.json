{
  "name": "hark",
  "private": true,
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @hark/website dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "macos:generate": "cd apps/macos && xcodegen generate",
    "macos:test": "cd apps/macos && xcodebuild -project SHarkMac.xcodeproj -scheme SHarkMac -destination 'platform=macOS' -derivedDataPath build/DerivedData CODE_SIGNING_ALLOWED=NO test",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "brand:check": "node scripts/generate-brand-assets.mjs --check && node scripts/check-fork-boundaries.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@resvg/resvg-js": "2.6.2",
    "fflate": "0.8.3"
  }
}
